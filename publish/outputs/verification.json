      "limiting_loss_formula": "max((p-H)/2, 0)",
      "limiting_loss_derivation": [
        {
          "regime": "H>p (overparameterized)",
          "Psi_limit": "-1/(2z)",
          "E_L_limit": "p/2 - p^2 sigma^2/(2 p sigma^2) = 0",
