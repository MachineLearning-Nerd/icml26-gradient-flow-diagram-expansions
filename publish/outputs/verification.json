      "integral_0_to_minusinf_F3": -0.03007975541865754,
      "rho_star_formula": "rho* = 1/(-16 theta int_0^{-inf} F^3)  (theta=1+3H/p^2)",
      "rho_star_theta1": 2.077809447919686,
      "threshold_eq23": "p^3 sigma^4 < rho*  <=>  low-noise (convergent ascent)",
      "pass": true
    },
    "verdict": "VERIFIED"
  },
